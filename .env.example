# ================================================================ Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ================================================================ DNS tunnel
DNS_PORT=5353
DNS_DOMAIN=c2.cyberai.local
DNS_SECRET=change-me-to-random-string

# ================================================================ Auth
JWT_SECRET=change-this-to-32-char-random-string!!
JWT_EXPIRES_IN=24h

# ================================================================ Admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# ================================================================ Database
DB_PATH=./db/cyberai.db

# ================================================================ Encryption
ENCRYPTION_KEY=change-this-32-char-encryption-key!
C2_SECRET=change-this-c2-shared-secret!!
PAYLOAD_KEY=change-this-payload-key-32-chars!

# ================================================================ GitHub (APK builder)
GITHUB_TOKEN=
GITHUB_REPO=
GITHUB_WORKFLOW=build-stub.yml

# ================================================================ Rate limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# ================================================================ CORS
CORS_ORIGIN=*

# ================================================================ Logging
LOG_LEVEL=info
